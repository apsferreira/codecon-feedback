# syntax=docker/dockerfile:1
#
# Imagem de desenvolvimento com hot reload via air. Build context deve ser a
# RAIZ do repositório (mesma razão do Dockerfile de produção: acesso a
# ../migrations). Usado só pelo docker-compose.yml, nunca em produção.

FROM golang:1.24
ENV GOTOOLCHAIN=auto
WORKDIR /app

RUN go install github.com/air-verse/air@latest

COPY backend/go.mod backend/go.sum ./
RUN go mod download

EXPOSE 3000
ENTRYPOINT ["air", "-c", ".air.toml"]
